# Public configuration. Values with NEXT_PUBLIC_ are included in the browser bundle.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Explicit deterministic demo for development/testing; never an automatic fallback.
# UMA_FRASE_AI_PROVIDER=demo
